{
  "name": "zero-reference",
  "version": "2.0.0",
  "description": "Find and show code with no references at all",
  "displayName": "Zero Reference",
  "publisher": "Ky6uk",
  "repository": "https://github.com/Ky6uk/vscode-zero-reference",
  "author": {
    "name": "Roman Nuritdinov (Ky6uk)",
    "email": "ky6uk.kun@gmail.com",
    "url": "https://github.com/Ky6uk"
  },
  "license": "MIT",
  "bugs": "https://github.com/Ky6uk/vscode-zero-reference/issues",
  "main": "./build/extension.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf build",
    "build": "vp run clean && tsc -p ./",
    "watch": "tsc --watch -p ./",
    "vscode:prepublish": "vp run build",
    "vscode:publish": "vsce publish",
    "package": "vsce package",
    "update:all": "taze --interactive --include-locked --exclude @types/vscode"
  },
  "engines": {
    "node": "24.x",
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "reference",
    "type",
    "cleanup",
    "codelens",
    "typescript"
  ],
  "galleryBanner": {
    "color": "#ffcc00"
  },
  "contributes": {
    "configuration": {
      "title": "Zero Reference configuration",
      "properties": {
        "zeroReference.useCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Use CodeLens for displaying entries with no references"
        }
      }
    },
    "commands": [
      {
        "command": "zeroReference.toggleCodeLens",
        "title": "Toggle CodeLens",
        "category": "Zero Reference"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:javascript",
    "onLanguage:javascriptreact"
  ],
  "devDependencies": {
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^3.9.2",
    "rimraf": "^6.1.3",
    "taze": "20.0.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.21.0"
}
